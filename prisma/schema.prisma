
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AdminAvatarPreset {
  DOG
  BEAR
  CAT
  FOX
  KOALA
  OWL
}

model Category {
  id  Int @id   @default(autoincrement())
  name  String
  slug  String
  products  Product[]
}

model AdminProfile {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  avatarPreset AdminAvatarPreset @default(BEAR)
  avatarImage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id  Int @id   @default(autoincrement())
  name  String
  price Float
  stock Int @default(20)
  image String
  description String?
  categoryId  Int
  category  Category @relation(fields: [categoryId], references: [id])
  orderItems OrderProducts[]
}

model Order {
  id  Int  @id  @default(autoincrement())
  name  String
  total Float
  date  DateTime @default(now())
  status  OrderStatus @default(PENDING)
  orderReadyAt  DateTime?
  orderProducts OrderProducts[]
}

model OrderProducts {
  id  Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id])
  productId Int
  product Product @relation(fields: [productId], references: [id])
  quantity  Int 
}
